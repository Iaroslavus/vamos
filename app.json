{
  "expo": {
    "name": "Vamos",
    "slug": "vamos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vamos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iaroslavus.vamos",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Vamos слушает фразу, чтобы проверить, понятно ли произношение. Запись не сохраняется.",
        "NSSpeechRecognitionUsageDescription": "Vamos распознаёт испанскую речь, чтобы сравнить фразу с образцом. Запись не сохраняется."
      }
    },
    "android": {
      "package": "com.iaroslavus.vamos",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF6EA"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Vamos слушает фразу, чтобы проверить, понятно ли произношение. Запись не сохраняется."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Vamos слушает фразу, чтобы проверить, понятно ли произношение. Запись не сохраняется.",
          "speechRecognitionPermission": "Vamos распознаёт испанскую речь, чтобы сравнить фразу с образцом. Запись не сохраняется.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-localization",
      "expo-status-bar",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
