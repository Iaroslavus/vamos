# Клиент (попадают в приложение — только публичные ключи)
# Локальный Supabase: `supabase start`, затем `supabase status -o env` → API_URL и ANON_KEY.
# Подробнее: README.md → «Локальный бэкенд». Значения кладите в .env.local (он в .gitignore).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# Сервер (только в секретах Supabase Edge Functions: `supabase secrets set ...`)
LLM_API_KEY=
SPEECH_API_KEY=
SPEECH_REGION=
TTS_API_KEY=
