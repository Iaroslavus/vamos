# Клиент (попадают в приложение — только публичные ключи)
# Локальный Supabase: `supabase start`, затем `supabase status -o env` → API_URL и ANON_KEY.
# Подробнее: README.md → «Локальный бэкенд». Значения кладите в .env.local (он в .gitignore).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# Сервер (только в секретах Supabase Edge Functions: `supabase secrets set ...`)
# Скрипты контента читают те же имена из окружения на машине автора. Не коммитить значения.
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
SPEECH_API_KEY=
SPEECH_REGION=
TTS_API_KEY=
TTS_API_URL=
TTS_MODEL=
TTS_VOICE=
# Запись в bucket audio. Только локально, не в клиент.
CONTENT_SUPABASE_URL=
CONTENT_SUPABASE_KEY=
