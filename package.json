  "scripts": {
    "start": "expo start",
    "start:dev": "npx expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "ios:dev": "npx expo run:ios",
    "web": "expo start --web",
    "generate:typed-routes": "expo customize tsconfig.json",
    "typecheck": "npm run generate:typed-routes && tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "content:check": "tsx scripts/content/check.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run content:check",
    "format": "prettier --write .",
    "db:types": "supabase gen types --lang=typescript --local --schema public > src/lib/database.types.ts && prettier --write src/lib/database.types.ts",
    "db:test": "supabase test db"
  },
  "private": true
